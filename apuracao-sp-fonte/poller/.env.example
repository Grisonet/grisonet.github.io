# Copie para .env e preencha
EVOLUTION_URL=https://sua-evolution.exemplo.com
EVOLUTION_APIKEY=coloque_sua_apikey
EVOLUTION_INSTANCE=nome_da_instancia
WHATSAPP_TO=5512999998888        # seu número com DDI 55 + DDD, só dígitos

# opcionais (têm padrão)
POLL_INTERVAL=30     # segundos entre leituras do TSE
MIN_MSG_GAP=180      # intervalo mínimo entre mensagens (anti-spam)
PROGRESS_STEP=2      # % de avanço na apuração que dispara nova mensagem
DRY_RUN=0            # 1 = só imprime no terminal, não envia WhatsApp
